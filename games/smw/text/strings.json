{
 "_about": "CLEAN ROOM. Every player-visible string of Bramble Isles, written fresh for this build. Message boxes: 8 lines x 18 chars. Castle text: lines top to bottom, <= 24 chars. Roll-call: one entry per name segment, in stripe segment order. Credits: one entry per credit slot (line = one-row font, big = two-row font).",
 "messages": {
  "4":  ["Far out at sea lie", "the Bramble Isles,", "a sunny chain of", "reefs and hills.", "Now Queen Marla", "has been snatched", "by King Grumbolt!", "Off you go, Tobi!"],
  "0":  ["-  CHIME  HALL  -", "The bell you rang", "here will now fill", "each hollow shape", "", "with     .", "The journey so far", "is stored as well."],
  "22": ["Hi there! I am out", "right now. King", "Grumbolt locked my", "cousins in eggs,", "so I went to crack", "them free.", "", "  Back soon, ZEEP"],
  "24": ["Phew! You hatched", "me out! Thanks!", "I am Zeep. I was", "heading off to", "free my kin when", "Grumbolt sealed me", "in that shell.", ""],
  "23": ["Hollow outlined", "blocks can become", "solid. To fill the", "yellow ones, head", "left, then up, to", "the bell at the", "peak of the hill.", ""],
  "5":  ["--  TRAVEL TIP  --", "A spare item waits", "in the frame at", "the top. Tap the", "SELECT button to", "drop it down when", "you need it.", ""],
  "11": ["--  TRAVEL TIP  --", "Hold X or Y to", "grab a shell. To", "toss it skyward,", "hold up on the pad", "and release the", "button.", ""],
  "21": ["The A button gives", "you a twirl jump.", "Big Tobi can twirl", "through certain", "blocks, and it", "flattens foes too", "tough to stomp.", ""],
  "6":  ["--  TRAVEL TIP  --", "This post is the", "halfway mark. Snap", "the ribbon and you", "will start again", "here if you fall.", "", ""],
  "15": ["--  TRAVEL TIP  --", "Those big shiny", "coins are Moon", "Medals. Gather", "five in a single", "stage for an extra", "life!", ""],
  "7":  ["Hold jump as you", "bop a foe to fly", "up extra high. In", "low water, push UP", "on the pad while", "jumping to leap", "higher.", ""],
  "20": ["Want to leave a", "stage you already", "beat? Press START", "to pause, then", "SELECT to go back", "to the map.", "", ""],
  "8":  ["Snap the ribbon at", "the finish to earn", "Sparkle Points.", "Bank 100 of them", "and a prize round", "opens up for you.", "", ""],
  "17": ["Jump and push UP", "to grab onto a", "fence. Push UP", "once more to step", "into the doorway", "that ends this", "stage.", ""],
  "18": ["--  TRAVEL TIP  --", "Brisk, a Thornling", "guards a Zeep in", "this keep. Shove", "him off the ledge", "into the hot lava", "to win.", ""],
  "10": ["With the cloak on,", "you can glide! Run", "fast, jump, then", "keep Y held. Lean", "either way on the", "pad to stay aloft.", "", ""],
  "12": ["Red spots on the", "map hide a second", "way out. With some", "skill and time to", "spare, hunt for", "both!", "", ""],
  "9":  ["Welcome to the", "Haunt. Will you", "ever find the way", "out? Hoo hoo hoo!", "", "", "", ""],
  "19": ["The L and R keys", "up top shift the", "view left or right", "so you can peek at", "what lies ahead.", "", "", ""],
  "13": ["Five secret doors", "lead to Comet Gate", "somewhere in the", "Bramble Isles.", "Find them all to", "hop between far", "corners of the", "islands."],
  "16": ["In this stage, the", "coins you hold or", "the clock may open", "a new path. Can", "you reach the", "hidden finish?", "", ""],
  "14": ["Wow! Not many get", "this far. Past", "here lies the", "Wild Reach. Beat", "it and the isles", "may look rather", "different...", "   BEST OF LUCK!"]
 },
 "castle": {
  "1": ["Brisk is beaten and his", "keep tumbles into the", "lava with a big gloop.", "A grateful Zeep hops out", "of its egg and grins.", "On to the meadows of", "Thistle Isle!"],
  "2": ["Fennel flops over, and", "his tower creaks, then", "folds up like a deck of", "old cards. Tobi waves", "goodbye to the meadows", "and peers down at the", "glowing caves of Cinder", "Grotto far below."],
  "3": ["Sorrel squeals and runs.", "The keep sinks into the", "warm rock with a fizz.", "Up above, two long rope", "bridges sway over the", "clouds of Sky Span.", "Up we go!"],
  "4": ["Cobble drops his hammer", "on his own toes. Yowch!", "The fort rattles apart", "stone by stone, and the", "dust drifts off toward", "the dark, twisty trees", "of the Tangle Woods.", "Mind the vines, Tobi!"],
  "5": ["Wisp fades out with a", "tiny pop. The spooky", "keep melts like a candle", "left out in the sun.", "Beyond the woods, a hot", "rocky isle steams in", "the sea. Onward!"],
  "6": ["Nettle sneezes so hard", "that her own keep blows", "over. Achoo! From the", "rubble, Tobi spots the", "gloomy gorge where King", "Grumbolt hides with the", "queen. Almost there...", "Be brave!"],
  "7": ["Gorse tumbles off the", "wall and his keep caves", "in. All seven Thornlings", "are beaten! Only King", "Grumbolt is left. His", "great dark hall waits at", "the bottom of the gorge.", "Time to end this!"]
 },
